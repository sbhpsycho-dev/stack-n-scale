{
  "name": "SNS — Whop Payment → Client Onboarding",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "YOUR_MAKE_WEBHOOK_ID",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "hook": { "label": "Whop Payment" }
          }
        },
        "parameters": [
          {
            "name": "hook",
            "type": "hook:gateway-respond",
            "label": "Webhook",
            "required": true
          }
        ],
        "expect": [
          { "name": "email",      "type": "text",   "label": "Customer Email" },
          { "name": "name",       "type": "text",   "label": "Customer Name" },
          { "name": "amount",     "type": "number", "label": "Amount (cents)" },
          { "name": "payment_id", "type": "text",   "label": "Whop Payment ID" }
        ]
      }
    },
    {
      "id": 7,
      "module": "google-email:ActionSendEmail",
      "version": 1,
      "parameters": { "__IMTCONN__": "YOUR_GMAIL_CONNECTION_ID" },
      "mapper": {
        "to": "{{1.email}}",
        "subject": "Welcome to Stack N Scale Enterprises",
        "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:0;background:#0a0a0a;font-family:'Georgia',serif;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0a0a0a;padding:48px 0;\"><tr><td align=\"center\"><table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#111111;border:1px solid #1e1e1e;border-radius:4px;\"><tr><td style=\"padding:40px 48px 32px;border-bottom:1px solid #1e1e1e;text-align:center;\"><p style=\"margin:0 0 8px;font-size:11px;letter-spacing:4px;color:#c8902a;text-transform:uppercase;\">Stack N Scale Enterprises</p><h1 style=\"margin:0;font-size:28px;font-weight:400;color:#f5f0e8;letter-spacing:1px;\">Welcome.</h1></td></tr><tr><td style=\"padding:40px 48px;\"><p style=\"margin:0 0 24px;font-size:16px;color:#c8b89a;line-height:1.8;\">Dear {{1.name}},</p><p style=\"margin:0 0 20px;font-size:15px;color:#a09070;line-height:1.9;\">Your payment has been received and your account is now active. Welcome to Stack N Scale Enterprises — we're glad to have you.</p><p style=\"margin:0 0 20px;font-size:15px;color:#a09070;line-height:1.9;\">Here's what happens next:</p><p style=\"margin:0 0 8px;font-size:15px;color:#a09070;line-height:1.9;\">1. You'll receive your onboarding form shortly — please complete it at your earliest convenience.</p><p style=\"margin:0 0 8px;font-size:15px;color:#a09070;line-height:1.9;\">2. Your coach will reach out within 24 hours to schedule your kickoff call.</p><p style=\"margin:0 0 36px;font-size:15px;color:#a09070;line-height:1.9;\">3. Once onboarding is complete, you'll receive access to your private Discord channel and the full Stack N Scale community.</p><p style=\"margin:0 0 4px;font-size:14px;color:#c8b89a;\">Warm regards,</p><p style=\"margin:0;font-size:14px;color:#c8902a;letter-spacing:1px;\">Stack N Scale Enterprises</p></td></tr><tr><td style=\"padding:24px 48px;border-top:1px solid #1e1e1e;text-align:center;\"><p style=\"margin:0 0 8px;font-size:11px;color:#3a3a3a;letter-spacing:1px;\">STACK N SCALE ENTERPRISES &nbsp;&middot;&nbsp; PRIVATE MEMBER CORRESPONDENCE</p><a href=\"https://www.skool.com/stack-n-scale-enterprises-2384\" style=\"color:#c8902a;text-decoration:none;font-size:11px;letter-spacing:1px;font-family:'Georgia',serif;\">stacknscale.com</a></td></tr></table></td></tr></table></body></html>",
        "contentType": "html"
      },
      "metadata": {
        "designer": { "x": 1800, "y": 0 },
        "restore": {
          "parameters": {
            "__IMTCONN__": { "label": "Gmail" }
          }
        }
      }
    },
    {
      "id": 11,
      "module": "google-email:ActionSendEmail",
      "version": 1,
      "parameters": { "__IMTCONN__": "YOUR_GMAIL_CONNECTION_ID" },
      "mapper": {
        "to": "{{1.email}}",
        "subject": "Action Required: Identity Verification — Stack N Scale Enterprises",
        "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;padding:0;background:#0a0a0a;font-family:'Georgia',serif;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0a0a0a;padding:48px 0;\"><tr><td align=\"center\"><table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#111111;border:1px solid #1e1e1e;border-radius:4px;\"><tr><td style=\"padding:40px 48px 32px;border-bottom:1px solid #1e1e1e;text-align:center;\"><p style=\"margin:0 0 8px;font-size:11px;letter-spacing:4px;color:#c8902a;text-transform:uppercase;\">Stack N Scale Enterprises</p><h1 style=\"margin:0;font-size:28px;font-weight:400;color:#f5f0e8;letter-spacing:1px;\">Identity Verification.</h1></td></tr><tr><td style=\"padding:40px 48px;\"><p style=\"margin:0 0 24px;font-size:16px;color:#c8b89a;line-height:1.8;\">Dear {{1.name}},</p><p style=\"margin:0 0 28px;font-size:15px;color:#a09070;line-height:1.9;\">To finalize your access, we need to verify your identity. This ensures a secure environment for all members of Stack N Scale Enterprises.</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:32px;\"><tr><td style=\"padding:24px 28px;background:#0f0f0f;border:1px solid #1e1e1e;border-radius:4px;\"><p style=\"margin:0 0 6px;font-size:11px;letter-spacing:3px;color:#c8902a;text-transform:uppercase;\">What You'll Need</p><ul style=\"margin:0 0 20px;padding-left:20px;\"><li style=\"font-size:13px;color:#6a5a40;line-height:2.2;\">A government-issued photo ID (driver's license, passport, or state ID)</li><li style=\"font-size:13px;color:#6a5a40;line-height:2.2;\">A selfie clearly showing your face while holding the ID</li><li style=\"font-size:13px;color:#6a5a40;line-height:2.2;\">Both documents must be fully visible and legible</li></ul><a href=\"https://stack-n-scale.vercel.app/onboarding/id-submit?name={{encodeURL(1.name)}}&amp;email={{encodeURL(1.email)}}\" style=\"display:inline-block;background:#c8902a;color:#0a0a0a;text-decoration:none;font-size:11px;letter-spacing:3px;text-transform:uppercase;padding:14px 32px;border-radius:2px;font-weight:600;\">Submit ID Verification</a></td></tr></table><p style=\"margin:0 0 20px;font-size:15px;color:#a09070;line-height:1.9;\">Once verified, you'll receive your onboarding questionnaire and access to your private Discord channel.</p><p style=\"margin:0 0 36px;font-size:15px;color:#a09070;line-height:1.9;\">If you require assistance at any stage, our team is available.</p><p style=\"margin:0 0 4px;font-size:14px;color:#c8b89a;\">Warm regards,</p><p style=\"margin:0;font-size:14px;color:#c8902a;letter-spacing:1px;\">Stack N Scale Enterprises</p></td></tr><tr><td style=\"padding:24px 48px;border-top:1px solid #1e1e1e;text-align:center;\"><p style=\"margin:0 0 8px;font-size:11px;color:#3a3a3a;letter-spacing:1px;\">STACK N SCALE ENTERPRISES &nbsp;&middot;&nbsp; PRIVATE MEMBER CORRESPONDENCE</p><p style=\"margin:0;\"><a href=\"https://www.skool.com/stack-n-scale-enterprises-2384\" style=\"color:#c8902a;text-decoration:none;font-size:11px;letter-spacing:1px;font-family:'Georgia',serif;\">stacknscale.com</a></p></td></tr></table></td></tr></table></body></html>",
        "contentType": "html"
      },
      "metadata": {
        "designer": { "x": 1800, "y": 300 },
        "restore": {
          "parameters": {
            "__IMTCONN__": { "label": "Gmail" }
          }
        }
      }
    },
    {
      "id": 8,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": false,
        "useNewZLibDeflate": true
      },
      "mapper": {
        "url": "YOUR_DISCORD_WEBHOOK_PAYMENT_URL",
        "method": "post",
        "headers": [
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\"content\":\"💰 New payment received from **{{1.name}}** — ${{formatNumber(1.amount / 100; 2)}}\"}",
        "parseResponse": false,
        "rejectUnauthorized": true,
        "followRedirect": true,
        "gzip": true
      },
      "metadata": {
        "designer": { "x": 2100, "y": 0 },
        "restore": {
          "expect": {
            "method":      { "label": "POST" },
            "bodyType":    { "label": "Raw" },
            "contentType": { "label": "JSON (application/json)" }
          }
        }
      }
    },
    {
      "id": 9,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": false,
        "useNewZLibDeflate": true
      },
      "mapper": {
        "url": "YOUR_DISCORD_WEBHOOK_DEAL_CLOSED_URL",
        "method": "post",
        "headers": [
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\"content\":\"🔥 **DEAL CLOSED — NEW CLIENT**\\n**{{1.name}}** just joined the program!\\nAmount: **${{formatNumber(1.amount / 100; 2)}}**\\n@Coach @Admin — onboarding is firing automatically.\"}",
        "parseResponse": false,
        "rejectUnauthorized": true,
        "followRedirect": true,
        "gzip": true
      },
      "metadata": {
        "designer": { "x": 2400, "y": 0 },
        "restore": {
          "expect": {
            "method":      { "label": "POST" },
            "bodyType":    { "label": "Raw" },
            "contentType": { "label": "JSON (application/json)" }
          }
        }
      }
    },
    {
      "id": 10,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": false,
        "useNewZLibDeflate": true
      },
      "mapper": {
        "url": "YOUR_DISCORD_WEBHOOK_NEW_CLIENT_URL",
        "method": "post",
        "headers": [
          { "name": "Content-Type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\"embeds\":[{\"title\":\"🎉 NEW CLIENT ONBOARDED\",\"description\":\"Welcome **{{1.name}}** to the program!\",\"color\":16737792,\"fields\":[{\"name\":\"Amount\",\"value\":\"${{formatNumber(1.amount / 100; 2)}}\",\"inline\":true},{\"name\":\"Email\",\"value\":\"{{1.email}}\",\"inline\":true},{\"name\":\"Source\",\"value\":\"Whop\",\"inline\":true},{\"name\":\"Status\",\"value\":\"✅ Payment confirmed\\n✅ GHL contact tagged\\n✅ Drive folder created\\n✅ Welcome email sent\",\"inline\":false}],\"footer\":{\"text\":\"@Coach — reach out within 24 hours to book their kickoff call\"}}]}",
        "parseResponse": false,
        "rejectUnauthorized": true,
        "followRedirect": true,
        "gzip": true
      },
      "metadata": {
        "designer": { "x": 2700, "y": 0 },
        "restore": {
          "expect": {
            "method":      { "label": "POST" },
            "bodyType":    { "label": "Raw" },
            "contentType": { "label": "JSON (application/json)" }
          }
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "us1.make.com"
  }
}
